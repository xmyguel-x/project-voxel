+/* Project Genesis - renderizador voxel por software para o core libretro.
+ * Recebe o framebuffer 16 bits do Genesis Plus GX e devolve um quadro 3D em voxels. */
+#ifndef PG_VOXEL_H
+#define PG_VOXEL_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include "libretro.h"
+
+#define VOX_MAX_W 960
+#define VOX_MAX_H 672
+
+bool vox_enabled(void);
+/* Lê as opções do frontend. Retorna true se ligar/desligar ou a resolução de saída mudou. */
+bool vox_check_options(retro_environment_t env);
+void vox_output_size(unsigned *w, unsigned *h);
+/* Entrada: analógico direito orbita a câmera, R3 reseta. */
+void vox_input(int rx, int ry, bool reset);
+/* src: pixels do emulador (RGB565, ou XRGB1555 sem FRONTEND_SUPPORTS_RGB565). */
+/* Le teclado/controle a cada quadro (camera: tecla 0 ou L3). */
+void vox_poll(retro_input_state_t st);
+const uint16_t *vox_render(const uint16_t *src, unsigned w, unsigned h, size_t pitch_bytes);
+
+#endif
